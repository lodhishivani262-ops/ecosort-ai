# ==============================================================================
# EcoSort AI - Environment Configuration Template
# COPY this file to .env and customize values for your local or production environment.
# NEVER commit the actual .env file containing sensitive credentials to Git.
# ==============================================================================

# Application Metadata
APP_NAME="EcoSort AI"
APP_ENV="development" # development | testing | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# CORS Configuration (Comma-separated list of allowed web frontend origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Upload and Security Limits
MAX_UPLOAD_SIZE_MB=5
RATE_LIMIT="10/minute"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# Logging Configuration
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL

# AI Service Configuration
AI_PROVIDER="gemini" # Configurable AI provider (default: gemini)
AI_MODEL="gemini-3.5-flash" # Configurable multimodal model identifier (e.g. gemini-3.5-flash)
GEMINI_API_KEY="" # Required for live AI perception calls; obtain from Google AI Studio
AI_TIMEOUT_SECONDS=20 # Maximum duration in seconds to wait for AI provider response
AI_MAX_RETRIES=2 # Maximum retry attempts on transient network or 5xx provider failures

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite:///./ecosort.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg://ecosort_user:secure_password@localhost:5432/ecosort_db"
DATA_RETENTION_DAYS=90 # Automatic retention threshold in days for classification records
METRICS_API_KEY="" # Optional security key for internal /api/v1/metrics endpoint (empty allows open dev access)

